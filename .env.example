# The app reads CKPS_* environment variables only; it never loads the old .env.
# API key/secret can also be entered in KET NOI for the current session.
CKPS_DNSE_API_KEY=
CKPS_DNSE_API_SECRET=
CKPS_TELEGRAM_TOKEN=
# One Telegram channel. Configure Chat ID in KET NOI > TELEGRAM / LICH.
# Optional absolute path for isolated local state.
# CKPS_RUNTIME_DIR=E:\CKPS-Runtime
